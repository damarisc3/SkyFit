# Copia este archivo como .env y llena tus valores reales (el .env NO se sube a GitHub)
PORT=5000
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/skyfit?retryWrites=true&w=majority&appName=Cluster0
# Orígenes permitidos para CORS, separados por coma
CLIENT_URL=http://localhost:3000
# Clave secreta para firmar los JWT (genera una larga y aleatoria, NUNCA la subas a GitHub)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
# Tiempo de vida del token (formato de jsonwebtoken: 5m = 5 minutos)
JWT_EXPIRES_IN=5m
